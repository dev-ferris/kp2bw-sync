# ---------- Required ----------
# URL of your Vaultwarden (must be HTTPS)
BW_SERVER=https://vault.example.lan
# Directory on the host that contains the .kdbx, and the file name
KEEPASS_DIR=/path/to/keepass
KEEPASS_FILE=db.kdbx

# ---------- Secrets ----------
# Use single quotes so that $ and # are not interpreted
KEEPASS_PASSWORD=''
BW_MASTER_PASSWORD=''
# Web vault: Settings → Security → Keys → View API key
BW_CLIENTID='user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'
BW_CLIENTSECRET=''

# ---------- Certificate (optional) ----------
# Only needed if Vaultwarden uses a certificate from your own/internal CA:
# path to the root certificate (PEM) on the host. If unset, only public CAs are trusted.
# CA_CERT=/path/to/root_ca.crt

# ---------- Optional (defaults shown) ----------
# Name of the internal Vaultwarden network
# VAULTWARDEN_NETWORK=vaultwarden_internal
# Schedule in cron format; runs without changes to the .kdbx are skipped
# CRON_SCHEDULE=*/15 * * * *
# Healthcheck fails if the last successful run is older (match it to the schedule)
# HEALTH_MAX_MINUTES=60
# Sync once right after the container starts
# RUN_ON_START=true
# Options passed to kp2bw
# KP2BW_ARGS=-v --skip-expired --no-include-recycle-bin
# Timeout for requests to Vaultwarden in seconds
# KP2BW_HTTP_TIMEOUT=300
# Resolve references/placeholders in title, URL, notes and custom fields first
# RESOLVE_REFS=true
# Delay used to detect a .kdbx that is currently being written
# SETTLE_SECONDS=3
# Time zone for logs and schedule
# TZ=UTC
# User that is allowed to read the .kdbx
# PUID=1000
# PGID=1000
# Image to run (other tag, e.g. kp2bw-3.7.1, or another registry)
# KP2BW_IMAGE=ghcr.io/dev-ferris/kp2bw-sync:latest
